# Copy to .env.production, set real values, and keep the resulting file out of source control.
# The owner role initializes schema; the app role is used by the backend at runtime.
POSTGRES_USER=canopy_owner
POSTGRES_PASSWORD=replace-with-a-long-random-owner-password
POSTGRES_DB=nursery_crm
APP_DB_USER=canopy_app
APP_DB_PASSWORD=replace-with-a-long-random-app-password
CLERK_ISSUER=https://replace-with-production-clerk-issuer
CLERK_JWKS_URL=https://replace-with-production-clerk-jwks-endpoint
CLERK_API_AUDIENCE=canopy-api
CADDY_DOMAIN=crm.example.com
